# Copier en deploy/.env (ou /opt/crm-lcp/deploy/.env) et compléter.
# Ne JAMAIS committer le .env réel (déjà ignoré par .gitignore).

# URL publique (utilisée dans les liens de vérification des signatures et les e-mails)
BASE_URL=https://lcp-certificationofdti.fr

# Envoi réel d'e-mails (SMTP). Sans SMTP_HOST, les e-mails restent simulés (table outbox).
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=ofdti@lcp-certification.fr
SMTP_PASSWORD=********
SMTP_FROM="LCP Certification OFDTI <ofdti@lcp-certification.fr>"
SMTP_TLS=1
# Infomaniak : hote mail.infomaniak.com, port 587, STARTTLS (identifiant = adresse complete)
